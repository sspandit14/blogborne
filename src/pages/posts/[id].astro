---
// Article page. Order follows the chosen mockup (from your sketch):
// title → kicker → dek → meta on a rule → wide cover → 680px body
// (Under Review box at top, footnotes at end) → tags band → prev/next box.
import type { InferGetStaticPropsType } from "astro";
import { render } from "astro:content";
import { Image } from "astro:assets";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPublishedPosts, formatDate, tagHref } from "../../lib/posts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts(); // newest first
  return posts.map((post, i) => ({
    params: { id: post.id },
    props: {
      post,
      issue: posts.length - i, // oldest post is No. 1
      prev: posts[i + 1],      // the older neighbour (undefined for the first post)
      next: posts[i - 1],      // the newer neighbour (undefined for the latest)
    },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;
const { post, issue, prev, next } = Astro.props;
const { Content } = await render(post);
const {
  title, kicker, description, pubDate, updatedDate, tags,
  cover, coverAlt, coverCaption, coverCredit, review,
} = post.data;
const reviewBy = review ? [review.creator, review.year, review.medium].filter(Boolean).join(" · ") : "";
---

<BaseLayout title={title} description={description}>
  <main class="wrap art-main">
    <article>
      <header class="art-head">
        <h1>{title}</h1>
        {kicker && <span class="kicker sc">{kicker}</span>}
        <p class="dek">{description}</p>
        <div class="info-rule sc">
          <span>
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
            <span aria-hidden="true">·</span>
            <span>No. {issue}</span>
            {updatedDate && (
              <>
                <span aria-hidden="true">·</span>
                <span>Revised <time datetime={updatedDate.toISOString()}>{formatDate(updatedDate)}</time></span>
              </>
            )}
          </span>
        </div>
      </header>

      {cover && (
        <figure class="cover">
          <Image
            src={cover}
            alt={coverAlt ?? ""}
            widths={[640, 1080, 2160]}
            sizes="(max-width: 1080px) 100vw, 1080px"
            loading="eager"
          />
          {(coverCaption || coverCredit) && (
            <figcaption>
              {coverCaption && <span class="cap">{coverCaption}</span>}
              {coverCredit && <span class="sc">{coverCredit}</span>}
            </figcaption>
          )}
        </figure>
      )}

      <div class="body prose">
        {review && (
          <aside class="review" aria-label="The work under discussion">
            <span class="label sc">Under Review</span>
            <cite>{review.title}</cite>
            {reviewBy && <span class="by">{reviewBy}</span>}
          </aside>
        )}
        <Content />
      </div>
    </article>

    {tags.length > 0 && (
      <div class="tagband sc">
        <span class="muted">Tags</span>
        {tags.map((t, i) => (
          <>
            {i > 0 && <span class="bar" aria-hidden="true">·</span>}
            <a href={tagHref(t)}>{t}</a>
          </>
        ))}
      </div>
    )}

    {(prev || next) && (
      <nav class="others" aria-labelledby="others-h">
        <h2 id="others-h" class="sc">Further in the Archive</h2>
        <div class="others-grid">
          {prev ? (
            <a href={`/posts/${prev.id}/`}>
              <span class="dir sc">← Previous</span>
              <span class="t">{prev.data.title}</span>
              {prev.data.kicker && <span class="kicker sc">{prev.data.kicker}</span>}
            </a>
          ) : <span />}
          {next && (
            <a class="next" href={`/posts/${next.id}/`}>
              <span class="dir sc">Next →</span>
              <span class="t">{next.data.title}</span>
              {next.data.kicker && <span class="kicker sc">{next.data.kicker}</span>}
            </a>
          )}
        </div>
      </nav>
    )}
  </main>
</BaseLayout>

<style>
  .art-main { max-width: 1240px; padding-top: 64px; }

  /* ---- head ---- */
  .art-head { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 14px; }
  h1 { margin: 0; max-width: 900px; font-weight: 500; font-size: clamp(40px, 5.2vw, 72px); line-height: 1.04; text-wrap: balance; }
  .art-head .kicker { font-size: 21px; }
  .dek { margin: 4px 0 0; max-width: 680px; font-style: italic; font-size: clamp(20px, 1.8vw, 25px); line-height: 1.4; color: var(--body-sub); text-wrap: balance; }
  .info-rule { width: 100%; max-width: 900px; display: flex; align-items: center; gap: 20px; margin-top: 8px; font-size: 18px; color: var(--muted); }
  .info-rule::before, .info-rule::after { content: ""; flex: 1; height: 1px; background: var(--rules); }
  .info-rule > span { display: flex; flex-wrap: wrap; justify-content: center; gap: 4px 14px; }

  /* ---- cover ---- */
  .cover { max-width: 1080px; margin: 40px auto 0; }
  .cover :global(img) { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border: 1px solid var(--rules); background: var(--surface); }
  figcaption { padding-top: 6px; font-size: 15px; color: var(--muted); display: flex; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; }
  .cap { font-style: italic; }

  /* ---- body ---- */
  .body { max-width: 680px; margin: 48px auto 0; } /* text styles come from .prose */

  .review { border-block: 1px solid var(--blood); padding: 14px 0; margin-bottom: 32px; display: flex; gap: 6px 18px; align-items: baseline; flex-wrap: wrap; }
  .review .label { font-size: 17px; }
  .review cite { font-style: italic; font-weight: 500; font-size: 23px; }
  .review .by { font-size: 17px; color: var(--body-sub); }

  /* drop cap on the opening paragraph (:global because it's Markdown output) */
  .body > :global(p:first-of-type)::first-letter {
    float: left; font-size: 4.6em; line-height: 0.8;
    padding: 0.1em 0.12em 0 0; color: var(--blood);
  }

  /* ---- after the article ---- */
  .tagband { margin-top: 56px; border-block: 1px solid var(--rules); padding: 12px 0; display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 4px 8px; font-size: 19px; }
  .tagband a { padding: 8px 10px; }

  .others { margin-top: 40px; border: 4px double var(--rules); padding: 24px 32px 28px; }
  .others h2 { margin: 0 0 20px; text-align: center; font-weight: 400; font-size: 17px; letter-spacing: 0.16em; color: var(--muted); }
  .others-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px; }
  .others-grid a { display: flex; flex-direction: column; gap: 6px; border: 1px solid var(--rules); padding: 20px; min-width: 0; }
  .others-grid a.next { text-align: right; }
  .dir { font-size: 16px; color: var(--muted); }
  .t { font-weight: 500; font-size: 26px; line-height: 1.2; }

  @media (max-width: 1000px) {
    .others-grid { grid-template-columns: minmax(0, 1fr); }
    .others-grid a.next { text-align: left; }
    .others-grid > span:empty { display: none; }
  }
  @media (max-width: 760px) {
    .art-main { padding-top: 40px; }
    .others { padding: 20px 16px; }
  }
</style>
