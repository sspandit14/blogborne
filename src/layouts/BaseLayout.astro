---
// The HTML shell every page shares: <head>, fonts, global CSS, header, footer.
// Pages pass a title/description; Home overrides the header via the "header" slot.
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE } from "../site";

interface Props {
  title?: string;
  description?: string;
}

const { title, description = SITE.tagline } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.title}` : SITE.title;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- logo font is self-hosted; preload it so the wordmark doesn't flash in a fallback -->
    <link rel="preload" href="/fonts/fleshandblood.ttf" as="font" type="font/ttf" crossorigin />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=EB+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
    />
  </head>
  <body>
    <slot name="header"><SiteHeader /></slot>
    <slot />
    <SiteFooter />
  </body>
</html>
