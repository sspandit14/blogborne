---
// Compact header used on every page except Home (Home has the full masthead).
// Logo on the left, page links on the right, nothing in between.
import { SITE, PAGES, url } from "../site";

const path = Astro.url.pathname; // includes the base, e.g. "/blogborne/about/"
const home = url("/");
// Home's path is a prefix of every path, so it only counts on an exact match
const isCurrent = (href: string) => (href === home ? path === home : path.startsWith(href));
---

<header class="chead">
  <div class="wrap">
    <a class="logo" href={home}>{SITE.title}</a>

    <nav class="pages sc" aria-label="Pages">
      {PAGES.map((p) => (
        <a href={p.href} class:list={{ "is-current": isCurrent(p.href) }} aria-current={isCurrent(p.href) ? "page" : undefined}>
          {p.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .chead { border-bottom: 4px double var(--rules); }
  .wrap {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px 24px;
    padding-block: 12px;
  }
  .logo { font-family: var(--font-mast); font-size: 40px; line-height: 1; }
  .pages { display: flex; gap: 22px; font-size: 19px; }

  @media (max-width: 760px) {
    .logo { font-size: 32px; }
    .pages { gap: 16px; }
  }
</style>
